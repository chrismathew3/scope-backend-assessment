# App connects as a non-owner role so Postgres row-level security applies.
DATABASE_URL="postgresql://scope_app:scope_app_dev@localhost:5432/scope_showtimes"
# Migrations, seeds and resets run as the owner.
MIGRATION_DATABASE_URL="postgresql://localhost:5432/scope_showtimes"
PORT=8787
WEB_ORIGIN="http://localhost:3000"
# Password given to every seeded account (dev only).
SEED_PASSWORD="showtimes-dev-pass"
# Reconciliation agent. With no credential the rules decide alone (agent status "off").
# Local dev: `vercel env pull apps/api/.env.local` gives a VERCEL_OIDC_TOKEN for AI Gateway (keep only that line).
AI_MODEL="google/gemini-3-flash"
AI_THINKING="low"
AI_TIMEOUT_MS=45000
# Optional alternatives to the gateway token:
# AI_GATEWAY_API_KEY=""
# Gemini's free API (https://aistudio.google.com/apikey). Takes priority over the gateway when set.
# GEMINI_API_KEY=""
# Gemini API model id for that path (the Gemini API calls Gemini 3 Flash "gemini-3-flash-preview").
# GEMINI_MODEL="gemini-3-flash-preview"
DEMO_MODE=true
