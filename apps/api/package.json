    "ai": "^7",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "0.45.4",
    "hono": "^4.13.13",
    "postgres": "^3.4.9",
    "trpc-to-openapi": "^3.3.3",
    "zod": "^4.6.7",
    "zod-openapi": "^6.0.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
