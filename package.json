{
  "name": "scope-showtimes",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --parallel --filter '@scope/api' --filter '@scope/web' dev",
    "dev:web": "bun run --filter '@scope/web' dev",
    "dev:api": "bun run --filter '@scope/api' dev",
    "build": "bun run --filter '@scope/web' build",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "bun run --filter '@scope/web' lint",
    "format:check": "bun run --filter '@scope/web' format:check",
    "test": "bun run --filter '@scope/api' test",
    "db:generate": "bun run --filter '@scope/api' db:generate",
    "db:migrate": "bun run --filter '@scope/api' db:migrate",
    "db:seed": "bun run --filter '@scope/api' db:seed",
    "db:seed:scale": "bun run --filter '@scope/api' db:seed:scale",
    "db:reset": "bun run --filter '@scope/api' db:reset"
  }
}
